{
  "name": "mealdeal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:catalog": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/features/catalog/*.test.mts",
    "seed:catalog": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-catalog-seed.mts",
    "test:planning": "tsc -p tsconfig.planning-tests.json && node --import ./tests/planning-paths.mjs --test .test-build/tests/planning.test.js"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "latest",
    "@supabase/supabase-js": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "tailwindcss": "latest",
    "typescript": "latest"
  }
}

# Auth0 SDK v4. Generate AUTH0_SECRET with: openssl rand -hex 32
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# Server-only Supabase credentials. Never prefix the service key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Set to 0 in production to require Auth0.
NEXT_PUBLIC_DEMO_MODE=1

# C: server-only planning generation. No key uses labeled local demo templates.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

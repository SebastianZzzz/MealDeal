# Auth0 SDK v4. Generate AUTH0_SECRET with: openssl rand -hex 32
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# Server-only pooled Tiger Data connection string. Never prefix with NEXT_PUBLIC_.
DATABASE_URL=

# Local-only demo identity. Production always requires Auth0.
NEXT_PUBLIC_DEMO_MODE=1

# C: server-only planning generation. No key uses labeled local demo templates.
GEMINI_API_KEY=
# Try Lite models first. Flash is used only when both Lite models are unavailable.
GEMINI_PLAN_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash
